# Copy to .env to override the defaults in docker-compose.yml. Nothing here is required.

# Host ports (bound to 127.0.0.1 only)
API_PORT=5080
WEB_PORT=3000
MONGO_PORT=27018
MAILPIT_UI_PORT=8025

# Where the browser reaches the web app and the API
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5080

# Development: leave empty and the API generates a signing key into the `keys` volume.
# Production: set a base64 key of at least 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=

# Password for demo@eventstorming.local created by `docker compose run --rm api seed` (default: eventstorming)
SEED_DEMO_PASSWORD=

API_ENVIRONMENT=Development
MONGO_DATABASE=eventstorming
