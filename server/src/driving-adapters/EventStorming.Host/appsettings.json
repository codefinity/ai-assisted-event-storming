{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27018/?replicaSet=rs0&directConnection=true",
    "Database": "eventstorming"
  },
  "Jwt": {
    "Issuer": "eventstorming",
    "Audience": "eventstorming-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ],
    "PublicApiOrigins": []
  },
  "RestApi": {
    "SignInPermitsPerMinute": 10,
    "PublicApiPermitsPerMinute": 300
  },
  "Security": {
    "PasswordHashIterations": 600000
  }
}
